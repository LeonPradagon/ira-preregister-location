# Backend runtime (copy these values to app/server/.env for local development)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://exact_location:exact_location@localhost:5432/exact_location
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173

# Validation rules
GPS_MAX_ACCURACY_METERS=30
HOME_RADIUS_METERS=50
MAX_LOCATION_ATTEMPTS=5
MAX_REMINDERS_PER_SESSION=3
COORDINATE_DISPLAY_DECIMALS=6
VERIFICATION_TOKEN_TTL_DAYS=7
REMINDER_LINK_TTL_HOURS=24
REMINDER_DEFAULT_1_HOURS=2
REMINDER_DEFAULT_2_HOURS=24
REMINDER_DEFAULT_3_HOURS=24
ADDRESS_SCORE_THRESHOLD=0.90
STREET_MATCH_THRESHOLD=0.90

# Feature and provider switches
ENABLE_CUSTOMER_OTP=false
ENABLE_IRA_COVERAGE=false
ENABLE_TICKETING=false
ENABLE_MANUAL_REVIEW=true
ENABLE_ADDRESS_EDIT=true
ENABLE_REMINDERS=true

# OpenStreetMap Nominatim fallback (maximum 1 request/second; keep attribution visible)
OSM_NOMINATIM_ENABLED=true
OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSM_NOMINATIM_USER_AGENT=ExactLocationCustomerValidation/1.0 (contact@example.com)
OSM_NOMINATIM_CACHE_TTL_MS=300000

# WhatsApp Cloud API / Meta (API key is a Meta access token)
# Example: https://graph.facebook.com/vXX.X/<PHONE_NUMBER_ID>
WHATSAPP_PROVIDER=meta
WHATSAPP_BASE_URL=
WHATSAPP_API_KEY=
WHATSAPP_INVITATION_TEMPLATE_NAME=exact_location_verification_invitation
WHATSAPP_INVITATION_TEMPLATE_LANGUAGE=id
WHATSAPP_REMINDER_TEMPLATE_NAME=exact_location_verification_reminder
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Frontend build-time API endpoint
VITE_API_URL=http://localhost:3000/v1
