# Production environment template
# Copy to .env in the repository root, then set secrets and public URLs.
# Run Compose from the repository root with:
# docker compose up --build -d

# Compose and database
COMPOSE_PROJECT_NAME=ira_preregist
POSTGRES_DB=ira_preregist
POSTGRES_USER=ira_preregist
POSTGRES_PASSWORD=change-this-database-password
API_PORT=3000
WEB_PORT=8080

# Public URLs
# Default: one origin via frontend Nginx. Set both URLs to your HTTPS domain in production.
# Keep VITE_API_URL=/v1 for the complete stack; use a public API URL for split deployment.
BETTER_AUTH_SECRET=change-this-to-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
VITE_API_URL=/v1
TRUST_PROXY=1

# Bootstrap admin (created automatically when missing; existing accounts are preserved)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_ADMIN_NAME=Production Super Admin

# Application features
ENABLE_CUSTOMER_OTP=false
ENABLE_IRA_COVERAGE=false
ENABLE_TICKETING=false
ENABLE_MANUAL_REVIEW=true
ENABLE_AUTO_APPROVAL=false
ENABLE_ADDRESS_EDIT=true
ENABLE_REMINDERS=true
MAX_LOCATION_ATTEMPTS=3
MAX_REMINDERS_PER_SESSION=3
REMINDER_TIMEZONE=Asia/Jakarta

# Location validation
GPS_MAX_ACCURACY_METERS=30
HOME_RADIUS_METERS=50
ADDRESS_SCORE_THRESHOLD=0.90
AUTO_APPROVAL_ADDRESS_SCORE_THRESHOLD=0.90
STREET_MATCH_THRESHOLD=0.90
STREET_SOFT_MATCH_THRESHOLD=0.70
VERIFICATION_TOKEN_TTL_DAYS=7
REMINDER_LINK_TTL_HOURS=24

# Geocoding. Google is primary when its key is set; OSM Nominatim remains the fallback.
GOOGLE_GEOCODING_API_KEY=
GOOGLE_GEOCODING_BASE_URL=https://maps.googleapis.com/maps/api/geocode/json
GEOCODING_BASE_URL=
GEOCODING_API_KEY=
OSM_NOMINATIM_ENABLED=true
OSM_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSM_NOMINATIM_USER_AGENT=IRA-Preregist/1.0 (contact@example.com)
GEOCODING_RATE_LIMIT_PER_SECOND=1

# WhatsApp Mekari/Qontak. Keep disabled until all credentials, channel, and templates are approved.
WHATSAPP_PROVIDER=disabled
WHATSAPP_BASE_URL=https://api.mekari.com/qontak/chat/v1
WHATSAPP_MEKARI_CLIENT_ID=
WHATSAPP_MEKARI_CLIENT_SECRET=
WHATSAPP_CHANNEL_INTEGRATION_ID=
WHATSAPP_INVITATION_TEMPLATE_ID=
WHATSAPP_REMINDER_TEMPLATE_ID=
WHATSAPP_INVITATION_TEMPLATE_NAME=ira_preregist_invitation
WHATSAPP_REMINDER_TEMPLATE_NAME=ira_preregist_reminder
WHATSAPP_INVITATION_TEMPLATE_PARAMETER_NAMES=name,link
WHATSAPP_REMINDER_TEMPLATE_PARAMETER_NAMES=name,link
WHATSAPP_WEBHOOK_SECRET=

# WhatsApp safety limits. These are fallbacks; the active values can be changed in Check Rules.
WHATSAPP_DAILY_SEND_LIMIT=1000
WHATSAPP_MIN_INTERVAL_MINUTES=60
WHATSAPP_RATE_LIMIT_PER_SECOND=1
WHATSAPP_CIRCUIT_MIN_ATTEMPTS=50
WHATSAPP_CIRCUIT_FAILURE_RATIO=0.3
WHATSAPP_CIRCUIT_COOLDOWN_MINUTES=15

# Campaign and worker controls
CAMPAIGN_MAX_BATCH_SIZE=1000
CAMPAIGN_DEFAULT_BATCH_SIZE=500
CAMPAIGN_DEFAULT_SEND_WINDOW_DAYS=0
CAMPAIGN_MATERIALIZATION_BATCH_SIZE=1000
CAMPAIGN_QUEUE_SCAN_LIMIT=100
CAMPAIGN_PROCESSING_TIMEOUT_MINUTES=10
IMPORT_BATCH_SIZE=500
IMPORT_WORKER_CONCURRENCY=1

# API/database operational limits
DATABASE_POOL_MAX=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_ADMIN_MAX=300
RATE_LIMIT_WEBHOOK_MAX=600
