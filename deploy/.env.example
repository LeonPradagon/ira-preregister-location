# Backend deployment
POSTGRES_DB=exact_location
POSTGRES_USER=exact_location
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
BETTER_AUTH_SECRET=change-this-to-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=https://api.example.com
WEB_ORIGIN=https://app.example.com
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_ADMIN_NAME=Production Super Admin

# Frontend deployment: this must be reachable by the browser, not by Docker DNS.
WEB_PORT=8080
VITE_API_URL=https://api.example.com/v1

# Provider and campaign defaults. Keep disabled until the real provider contract is tested.
WHATSAPP_PROVIDER=disabled
WHATSAPP_BASE_URL=
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=id
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_DAILY_SEND_LIMIT=10000
WHATSAPP_MIN_INTERVAL_MINUTES=60
WHATSAPP_RATE_LIMIT_PER_SECOND=2
CAMPAIGN_DEFAULT_BATCH_SIZE=1000
CAMPAIGN_DEFAULT_SEND_WINDOW_DAYS=7
CAMPAIGN_MATERIALIZATION_BATCH_SIZE=1000
CAMPAIGN_QUEUE_SCAN_LIMIT=100
